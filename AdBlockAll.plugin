#!name = 去广告合集
#!desc = 闲鱼 + 京东 + 传祺 + 网易云音乐 去广告/解锁合一插件。闲鱼：开屏广告、首页/同城信息流广告、详情页推荐广告、直播/小游戏广告、鱼塘弹窗、广告上报拦截（基于闲鱼 7.28.80 IPA 逆向）；京东：开屏广告(URL+POST body 双通道)、QUIC 旁路拦截、首页/购物车/订单/个人页推荐楼层与弹窗、uniformRecommend 推荐流、埋点上报域名屏蔽（基于京东 16.1.80 IPA 逆向+抓包）；传祺：开屏广告(广告位数据源+弹窗开关+登录页开屏视频)、悬浮/游戏/PK/签到/推荐广告、运营弹窗、社区/商城/车控 Banner、埋点域名屏蔽（基于传祺 6.2.0 IPA 逆向）；网易云：VIP 歌曲解锁（默认关闭，插件参数中开启；eapi 协议级，试听 30 秒变整曲播放，基于 9.6.15 脱壳 IPA 逆向）。脚本已内置远程地址，安装即用。日志搜 [JD-FID]/[NM-VIP] 可观测京东拦截/网易云解锁命中（低耗电）。
#!author = y0unge, aoconch
#!homepage = https://github.com/y0unge/ad-block-collection
#!category = 去广告
#!tag = 闲鱼,京东,传祺,网易云,去广告,解锁
#!date = 2026-10-29

# ================================================================
# 去广告合集 (闲鱼 + 京东 + 传祺 + 网易云) Loon 插件
#
# 闲鱼部分: 基于 com.taobao.fleamarket 7.28.80 脱壳 IPA 逆向
#   开屏广告   FishSplashAdManager 经 mtop.taobao.idlecommerce.splash.{ads,async.ads,config}
#   信息流广告 fish_home_advertise_card_d3/d4、fish_local_advertise_card_d4、
#              idlefish_local_feed2_marketing、fish_home_feeds_pager_banner
#   详情页广告 detail_recommend_ad_card
#
# 京东部分: aoconch/jd-loon-remove-recommend + 本仓库增强(16.1.80 IPA 逆向)
#   开屏广告   start 响应清理(images/showTimesDaily/startADImage)，
#              覆盖 POST body 传参通道(请求侧脚本读取 body 拦截)
#   QUIC旁路   京东 Cronet 可走 QUIC 绕过 MITM，已拦截强制回退 TCP
#   推荐楼层   楼层 mId/标题匹配递归清理 (uniformRecommend 等接口)
#   埋点上报   mars.jd.com 等 18 个上报域名 REJECT
#
# 传祺部分: 基于 com.cloudyoung.TrumpchiCarSalesDev 6.2.0 脱壳 IPA 逆向
#   开屏广告   checkPostOrAdvertiseForOpenPageWithModel: 启动展示"帖子或广告"开屏页，
#              全 App 广告位数据源统一走 getAdvertiseByPositionCode，
#              开屏弹窗开关 advertise/isalert、登录页开屏视频 getLoginVideoAndCover
#   页面广告   首页右下悬浮/游戏/PK/签到/推荐广告 (均为 YYAdvertiseModel)
#   运营弹窗   car/activity/v2/popup、车控任务/运动弹窗、selectPopupText
#   Banner    社区/商圈/商城/车控/充电服务 bannerlist 系列
#   埋点上报   神策/友盟/UT/EMAS/Rangers/高德日志域名 REJECT
#
# 网易云音乐部分: 基于 com.netease.cloudmusic 9.6.15 脱壳 IPA 逆向
#   VIP 解锁   eapi 协议级: 响应为 AES-128-ECB 原始密文(密钥 e82ckenh8dichen8,
#              CloudMusicCoSDK, 参数经 UTF-16 交错 base64 + 主密钥 AES 二级封装
#              隐藏于 __TEXT.__const)；VIP 试听 30s 裁剪是客户端行为 ——
#              /eapi/song/enhance/player/url 响应中 freeTrialInfo 之外 url 即完整
#              音频文件，解密置空后整曲播放；privilege(payed/pl/dl/st) 修补使
#              VIP 歌曲点击直接进入播放。默认关闭，插件参数中开启。
#
# 使用说明:
#   1. Loon 安装并信任 CA 证书，开启 MITM 总开关
#   2. 安装本插件即可，脚本经远程地址自动加载
#   3. 如只需单个 App 的去广告，可安装 XianyuAdBlock / JDAdBlock /
#      TrumpchiAdBlock 单项插件；只要网易云解锁可装 NeteaseMusicVIP
#   4. 网易云 VIP 解锁默认关闭：插件参数中把 netease_vip 置开即可
# ================================================================

[Argument]
# 网易云 VIP 解锁开关(默认关闭; 开启后 VIP 歌曲试听变整曲播放)
# 关闭时脚本直接放行, 不做任何解密, 零开销
netease_vip = boolean,false,网易云音乐 VIP 歌曲解锁（开启后 VIP 歌曲试听 30 秒变整曲播放；关闭则不解密不拦截，完全放行）

[Rule]
# --- 京东: 屏蔽 QUIC/UDP，强制走 TCP 以便 MITM 解密 ---
AND, ((DOMAIN, api.m.jd.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, jd.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN, api.m.jd.com), (PROTOCOL, UDP)), REJECT
# --- 京东: 埋点/统计/监控上报域名 (基于抓包+IPA逆向) ---
DOMAIN,mars.jd.com,REJECT
DOMAIN,perf.m.jd.com,REJECT
DOMAIN,h5speed.m.jd.com,REJECT
DOMAIN,sh.jd.com,REJECT
DOMAIN,anti-sdk-report.m.jd.com,REJECT
DOMAIN,uranus.jd.com,REJECT
DOMAIN,mllog.jd.com,REJECT
DOMAIN,ex.m.jd.com,REJECT
DOMAIN,cltm.jd.com,REJECT
DOMAIN,ccflbs.m.jd.com,REJECT
DOMAIN,dsap.jd.com,REJECT
DOMAIN,jra.jd.com,REJECT
DOMAIN,sdkfp.jd.com,REJECT
DOMAIN,device-security-url.jd.com,REJECT
DOMAIN,policy.jd.com,REJECT
# 注: jddebug.com 不做 REJECT —— 京东 App 自身会探测其随机子域(反劫持检测)；
# 脚本已不再使用该域名做观测日志(低耗电优化，移除每请求必超时 DNS 查询)
# --- 京东: 广告 ---
DOMAIN,im-x.jd.com,REJECT
DOMAIN,imgcps.jd.com,REJECT
# --- 闲鱼: 阿里妈妈 Tanx 广告交易 (click.tanx.com / ifs.tanx.com / ef-dongfeng.tanx.com) ---
DOMAIN-SUFFIX,tanx.com,REJECT
# --- 腾讯广点通 ---
DOMAIN-SUFFIX,gdt.qq.com,REJECT
# --- 穿山甲 (CSJ) ---
DOMAIN-SUFFIX,ad.toutiao.com,REJECT
DOMAIN-SUFFIX,ad.oceanengine.com,REJECT
DOMAIN-SUFFIX,pangle.cn,REJECT
DOMAIN-SUFFIX,csjplatform.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,lf-ad-ies.bytecdn.cn,REJECT
DOMAIN,bridge.bytedance.com,REJECT
# --- 快手/百度联盟广告 ---
DOMAIN,e.kuaishou.com,REJECT
DOMAIN,mobads.baidu.com,REJECT
DOMAIN,mobads-logs.baidu.com,REJECT
# --- 闲鱼: Fanti (优酷/阿里文娱联盟) 广告SDK: 联盟开屏兜底/激励视频 (ssp.iytcdn.com) ---
DOMAIN-SUFFIX,iytcdn.com,REJECT
# --- 闲鱼: 优酷联盟视频SDK配置 (sealine.youku.com/sdkconfig_*.xml; 商品视频走
#     vod.300hu.com 不受影响。2026-10-29 抓包: 该域 DNS 解析为空仍反复重试) ---
DOMAIN,sealine.youku.com,REJECT
# --- 闲鱼: BeiZi 广告聚合SDK: s2s竞价与接口 (bid.ad-scope.com.cn / sdk.beizi.biz) ---
DOMAIN-SUFFIX,ad-scope.com.cn,REJECT
DOMAIN-SUFFIX,beizi.biz,REJECT
# --- 传祺: 埋点/统计上报域名 (基于 6.2.0 IPA 逆向) ---
# 神策埋点 (gets.gacmotor.com:8443/sa)
DOMAIN,gets.gacmotor.com,REJECT
# 字节 RangersAppLog 埋点
DOMAIN-SUFFIX,volceapplog.com,REJECT
# 友盟日志上报
DOMAIN,ulogs.umeng.com,REJECT
DOMAIN,ulogs.umengcloud.com,REJECT
DOMAIN,cnlogs.umeng.com,REJECT
DOMAIN,cnlogs.umengcloud.com,REJECT
DOMAIN,alogsus.umeng.com,REJECT
DOMAIN,alogus.umeng.com,REJECT
DOMAIN,log.umsns.com,REJECT
DOMAIN,c.umsns.com,REJECT
# 阿里 UT / EMAS / usertrack 埋点
DOMAIN,h-adashx.ut.taobao.com,REJECT
DOMAIN,adash.man.aliyuncs.com,REJECT
DOMAIN,service-usertrack.alibaba-inc.com,REJECT
# 传祺自有域名的 EMAS 上报 (app-emas.gacmotor.com:5443/u/...，2026-10-29 抓包)
DOMAIN,app-emas.gacmotor.com,REJECT
# 高德日志上报 (仅拦日志域，地图/定位功能域名不拦)
DOMAIN,logs.amap.com,REJECT
DOMAIN,dualstack-logs.amap.com,REJECT
# --- 传祺: 广告素材 CDN (华为 Ads) ---
DOMAIN,cdn.adscloud.huawei.com,REJECT
DOMAIN,cdn.adscloud.huawei.com.cn,REJECT

[Rewrite]
# ==================== 闲鱼 ====================
# --- 开屏广告 (FishSplashAd) ---
# 已改为响应篡改方案(见 [Script] 闲鱼_开屏频控归零): 频控字段归零让App主动跳过开屏,
# 不再使用 reject(请求失败会触发联盟兜底/重试/缓存展示)。Fanti/BeiZi域名REJECT保留兜底。
# --- 直播首页广告 ---
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.live\.home\.ads\.material\.get\/ url reject
# --- 小游戏/互动激励广告 (看广告得奖励类，不需要可删除对应行) ---
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlecommerce\.game\.iaa\.ads\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.mini\.game\.ad\.url\.query\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.play\.ad\.(?:query|event\.(?:query|push))\/ url reject
# --- 鱼塘弹窗 ---
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.fishpool\.poplayerinfo\/ url reject
# --- 广告曝光/点击/结算上报 ---
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.idle\.ad\.(?:click|expose|failed\.batch\.(?:click|expose))\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.ali\.ad\.settle\.(?:brand\.log|cpc\.click|cpm\.click|tanx\.click|tianhe\.click)\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.tmall\.jiuxi\.activity\.ad\.upstream\.report\.(?:click|impression)\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.(?:life\.ad\.click\.get|o2o\.ad\.(?:action|exposure|gateway)\.get)\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.idle\.idleadv\.(?:app\.launch\.report|xyflowin\.upload|scene\.restore)\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlehome\.home\.pop\.interest\.upload\/ url reject
# ==================== 京东 ====================
# --- 推荐流接口直接返回空 JSON ---
^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=uniformRecommend\d* url reject-dict
# --- storage.jd.com 上的推荐资源返回空 JSON ---
^https:\/\/storage\.jd\.com\/mpaas2-public\/product\/[^\/]+\/recommend_jdur url reject-dict
# --- 纯广告接口 (GET/OPTIONS 场景，URL 带 functionId) ---
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=queryPagePopWindow - reject
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=babelGetGuideTips - reject
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=secondFloor - reject
# ==================== 传祺 ====================
# 网关前缀: 生产 API 经网关路由路径带模块前缀(next.gacmotor.com/app/app-api/...、
# /mall/content-app/...)，与 IPA 裸路径不同，规则用 (?:[a-z0-9\-]+\/)* 通配兼容
# --- 开屏广告: 数据源(positionCode=1)与登录页开屏视频走响应篡改脚本(见 [Script] 段,
#     返回"成功但无广告"避免 reject 触发缓存兜底),此处不再 reject-dict ---
# --- 开屏广告弹窗开关 ---
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*app-api\/baseinfo\/advertise\/isalert url reject-dict
# --- 运营弹窗: 活动/车控任务/运动/车控端弹窗文本 ---
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*app-api\/car\/activity\/v2\/popup url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*car-api\/leopard\/school\/home\/taskPopup url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*car-api\/vcontrol\/sport\/avpopup url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*gacmotor-vehicle-app\/v1\/popup\/text\/selectPopupText url reject-dict
# --- Banner: 社区/商圈/商城/车控/充电服务 ---
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*community-api\/community\/api\/bannerlist url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*community-api\/community\/api\/post\/getcircleinfobanner url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*circle-api\/activity\/activityBanner\/list url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*mall-api\/commodity\/bannerList url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*mall-api\/mall\/home\/querySubCategoryBannerList url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*gacmotor-vehicle-app\/v1\/banner\/selectList url reject-dict
# 充电服务 Banner (路径较通用，限定广汽域名避免误伤其他 App)
^https?:\/\/[a-z0-9\.\-]*gac(?:motor|ne|e)[a-z0-9\.\-]*\.com(?:\.cn)?\/(?:[a-z0-9\-]+\/)*api\/bannerlist url reject-dict
^https?:\/\/[a-z0-9\.\-]*gac(?:motor|ne|e)[a-z0-9\.\-]*\.com(?:\.cn)?\/(?:[a-z0-9\-]+\/)*v1\/banner\/selectList url reject-dict

[Script]
# ==================== 闲鱼: 开屏频控归零 + 信息流/详情页广告卡片过滤 ====================
http-response ^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlecommerce\.splash\.(?:ads|async\.ads|config)\/ requires-body=1, script-path=https://raw.githubusercontent.com/y0unge/ad-block-collection/main/XianyuSplashFix.js, tag=闲鱼_开屏频控归零
http-response ^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlehome\.home(?:\.nextfresh)?\/ requires-body=1, script-path=https://raw.githubusercontent.com/y0unge/ad-block-collection/main/XianyuAdBlock.js, tag=闲鱼_首页信息流去广告
http-response ^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.home\.nextnearby\/ requires-body=1, script-path=https://raw.githubusercontent.com/y0unge/ad-block-collection/main/XianyuAdBlock.js, tag=闲鱼_同城信息流去广告
http-response ^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.(?:item\.detail|detail\.preget|awesome\.detail(?:\.unit)?)\/ requires-body=1, script-path=https://raw.githubusercontent.com/y0unge/ad-block-collection/main/XianyuAdBlock.js, tag=闲鱼_详情页去广告
# ==================== 京东 ====================
# 请求侧: 读取 POST body 中的 functionId(京东新网络栈将 fid 序列化进 body，URL 匹配对其无效)，
# 纯广告接口本地返回空 JSON，命中拦截时记录 [JD-FID] 日志(低耗电：不再全量流水/无观测 DNS 查询)
# 覆盖全部 API 网关域名变体(UnitRouter 机制): api/api-q/squnit-api/quic-api.m.jd.com, api-ai/squnit-api-ai.jd.com
# 注: 使用 Loon 3.5.1(983)+ 新语法(实测旧语法 http-request 在部分环境不触发)
request if ${url} ~= /^https?:\/\/((api|api-q|squnit-api|quic-api)\.m\.jd\.com|(squnit-api-)?api-ai\.jd\.com)\/(client\.action|api)/i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/jd_ad_request.js") with tag="京东_广告请求拦截", timeout=20, requires_body=true
# 响应侧: aoconch 原版逻辑(fid 从 URL/body/嵌套 JSON 提取 + 楼层 mId/标题递归清理 + uniformRecommend 空包)
# + 本仓库增强: startADImage 清理(16.1.80 IPA)、双 $done 修复、[JD-FID] 命中日志、
# 低耗电优化(无特征响应预检跳过/观测 DNS 查询移除)
response if ${url} ~= /^https?:\/\/((api|api-q|squnit-api|quic-api)\.m\.jd\.com|(squnit-api-)?api-ai\.jd\.com)\/(client\.action|api)/i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/JD_remove_ads.js") with tag="京东_广告响应清理", timeout=20, requires_body=true
# ==================== 传祺: 开屏广告响应篡改 ====================
# 开屏广告数据源(positionCode=1) + 登录页开屏视频: 返回"成功但无广告",
# 避免 reject 触发本地缓存/兜底展示 (参考闲鱼教训; Loon 日志搜 [GAC-AD])
http-response ^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*app-api\/(?:baseinfo\/advertise\/getAdvertiseByPositionCode|login\/getLoginVideoAndCover) requires-body=1, script-path=https://raw.githubusercontent.com/y0unge/ad-block-collection/main/TrumpchiSplashFix.js, tag=传祺_开屏响应篡改
# ==================== 网易云音乐: VIP 歌曲解锁 (默认关闭, 参数 netease_vip 开启) ====================
# eapi 响应为原始二进制 AES 密文, 需 binary-body-mode; 脚本内检查 netease_vip 参数,
# 关闭时直接放行零开销。覆盖: 播放/下载 URL(核心)、privilege、歌曲/歌单详情、
# 搜索、每日推荐、batch 聚合、心动模式
http-response ^https?:\/\/(?:[^\/]+\.)?music\.163\.com\/eapi\/(?:song\/enhance\/(?:player|download)\/url(?:\/v1)?|song\/enhance\/privilege|v3\/song\/detail|v[36]\/playlist\/detail|playlist\/detail|(?:cloud)?search|v1\/discovery|v3\/discovery|batch|playmode\/intelligence) requires-body=1, binary-body-mode=true, script-path=https://raw.githubusercontent.com/y0unge/ad-block-collection/main/netease_music_vip.js, tag=网易云_VIP解锁

[MITM]
# 低耗电: 京东侧仅保留有 Rewrite/Script 规则实际命中的域名(mars/policy 已 REJECT，
# api/routine/color/waapdg 无规则引用)；闲鱼侧已覆盖 goofish.com 新网关(2026-10-29
# 抓包确认 mtop 网关迁移)+旧 taobao.com 网关；传祺通配保持不变(收窄会漏广告)；
# 网易云仅 API 域(音频文件走 music.126.net CDN 不解密)
hostname = acs.m.goofish.com, g-acs.m.goofish.com, acs.m.taobao.com, guide-acs.m.taobao.com, h5api.m.taobao.com, unszacs.m.taobao.com, unzbyunacs.m.taobao.com, api.m.jd.com, squnit-api.m.jd.com, quic-api.m.jd.com, api-q.m.jd.com, api-ai.jd.com, squnit-api-ai.jd.com, storage.jd.com, *.gacmotor.com, *.gacne.com.cn, *.gace.com.cn, music.163.com, *.music.163.com
