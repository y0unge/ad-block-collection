#!name = 去广告合集
#!desc = 闲鱼 + 京东 + 传祺 去广告合一插件。闲鱼：开屏广告（2026-10-30 抓包实锤 realTimeAd 下发通道，删除该节点使 App 主动跳过）、首页/同城信息流广告（广告模板特征 + cardType=mamaAD/homeMultiBanner 双通道过滤）、搜索结果广告卡片与热词填充、详情页推荐广告、直播/小游戏广告、鱼塘弹窗、广告上报拦截（基于闲鱼 7.28.80 IPA 逆向+抓包，信息流/搜索规则参考 kelee FleaMarket 2026-10-02 版）；京东：开屏广告(URL+POST body 双通道，含加密 body/根路径通道的 fid 无关兜底)、QUIC 旁路拦截、首页/购物车/订单/个人页推荐楼层与弹窗、uniformRecommend 推荐流、埋点上报域名屏蔽（基于京东 16.1.80 IPA 逆向+抓包）；传祺：开屏广告(广告位数据源+弹窗开关+登录页开屏视频)、悬浮/游戏/PK/签到/推荐广告、运营弹窗、社区/商城/车控 Banner、埋点域名屏蔽（基于传祺 6.2.0 IPA 逆向）。全部脚本已迁移 Loon 新语法并内置远程地址，安装即用。日志搜 [JD-FID]/[XY-Splash]/[GAC-AD] 可观测拦截命中（低耗电）。网易云音乐 VIP 解锁已拆分为独立插件 NeteaseMusicVIP，需要单独安装。
#!author = y0unge, aoconch
#!homepage = https://github.com/y0unge/ad-block-collection
#!category = 去广告
#!tag = 闲鱼,京东,传祺,去广告
#!date = 2026-11-06

# ================================================================
# 去广告合集 (闲鱼 + 京东 + 传祺) Loon 插件
#
# 闲鱼部分: 基于 com.taobao.fleamarket 7.28.80 脱壳 IPA 逆向 + 跨零点抓包
#   开屏广告   FishSplashAdManager 经 mtop.taobao.idlecommerce.splash.{ads,async.ads,config}
#              拉取；实际下发通道为响应 data.realTimeAd.mamaAd.imageMaterial(品牌广告,
#              服务端实时决策,响应无频控字段)，脚本删除 realTimeAd 节点
#              (与服务器"当日无广告"响应形状一致,App 主动跳过)
#   信息流广告 fish_home_advertise_card_d3/d4、fish_local_advertise_card_d4、
#              idlefish_local_feed2_marketing、fish_home_feeds_pager_banner
#   详情页广告 detail_recommend_ad_card
#
#   2026-11-06 信息流/搜索补强 (参考 kelee.one FleaMarket_remove_ads.lpx
#   2026-10-02 版,只并入其"去广告类"规则,其"精简类"规则如我的页/订单页/
#   圈子/顶部Banner白名单均不采用,保持本插件只去广告的定位):
#     a) 信息流广告除模板特征外还存在 cardType 载体: section 的
#        data.clickParam.args.cardType == "mamaAD"(阿里妈妈)或
#        "homeMultiBanner" —— XianyuAdBlock.js 特征表已补齐,
#        商品列表残留广告即此载体
#     b) 搜索结果广告: g-acs 网关 idlemtopsearch.search 的 resultList 中
#        bizType=="ad" 商品卡删除 + resultPrefixBar 运营条删除;
#        search.shade 填充词 reject; search.discover 过滤 MarketHotSpot;
#        item.search.activate 删除搜索框热词
#     c) 详情页推荐列表 idle.item.recommend.list 整体 reject(与脚本内
#        detail_recommend_ad_card 卡片过滤互补)
#     d) 杂项: user.strategy.list/playboy.recommend/item.buy.feeds/
#        local.near.by.corner.info reject; 关注页 follow.feed.list 只留
#        cardType==2001; 社区信息流 community 只留商品卡/内容卡;
#        新品页 newitem.page 过滤 banner/mamaAD; 同城首页 local.home
#        过滤 cardEnum==ads; magic.home.page.list 删顶部运营列表
#
# 京东部分: aoconch/jd-loon-remove-recommend + 本仓库增强(16.1.80 IPA 逆向)
#   开屏广告   start 响应清理(images/showTimesDaily/startADImage)，
#              覆盖 POST body 传参通道(请求侧脚本读取 body 拦截)；
#              加密 body/根路径通道下 fid 不可见时按字段特征递归兜底清理
#   QUIC旁路   京东 Cronet 可走 QUIC 绕过 MITM，已拦截强制回退 TCP
#   推荐楼层   楼层 mId/标题匹配递归清理 (uniformRecommend 等接口)
#   埋点上报   mars.jd.com 等 18 个上报域名 REJECT
#
# 传祺部分: 基于 com.cloudyoung.TrumpchiCarSalesDev 6.2.0 脱壳 IPA 逆向
#   开屏广告   checkPostOrAdvertiseForOpenPageWithModel: 启动展示"帖子或广告"开屏页，
#              全 App 广告位数据源统一走 getAdvertiseByPositionCode，
#              开屏弹窗开关 advertise/isalert、登录页开屏视频 getLoginVideoAndCover
#   页面广告   首页右下悬浮/游戏/PK/签到/推荐广告 (均为 YYAdvertiseModel)
#   运营弹窗   car/activity/v2/popup、车控任务/运动弹窗、selectPopupText
#   Banner    社区/商圈/商城/车控/充电服务 bannerlist 系列
#   埋点上报   神策/友盟/UT/EMAS/Rangers/高德日志域名 REJECT
#
# 使用说明:
#   1. Loon 安装并信任 CA 证书，开启 MITM 总开关
#   2. 安装本插件即可，脚本经远程地址自动加载
#   3. 如只需单个 App 的去广告，可安装 XianyuAdBlock / JDAdBlock /
#      TrumpchiAdBlock 单项插件
#   4. 网易云音乐 VIP 解锁为独立插件 NeteaseMusicVIP(含换源/降级模式)，
#      需要时从仓库单独安装，不在本合集内
# ================================================================

[Rule]
# --- 京东: 屏蔽 QUIC/UDP，强制走 TCP 以便 MITM 解密 ---
AND, ((DOMAIN, api.m.jd.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, jd.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN, api.m.jd.com), (PROTOCOL, UDP)), REJECT
# --- 京东: 埋点/统计/监控上报域名 (基于抓包+IPA逆向) ---
DOMAIN,mars.jd.com,REJECT
DOMAIN,perf.m.jd.com,REJECT
DOMAIN,h5speed.m.jd.com,REJECT
DOMAIN,sh.jd.com,REJECT
DOMAIN,anti-sdk-report.m.jd.com,REJECT
DOMAIN,uranus.jd.com,REJECT
DOMAIN,mllog.jd.com,REJECT
DOMAIN,ex.m.jd.com,REJECT
DOMAIN,cltm.jd.com,REJECT
DOMAIN,ccflbs.m.jd.com,REJECT
DOMAIN,dsap.jd.com,REJECT
DOMAIN,jra.jd.com,REJECT
DOMAIN,sdkfp.jd.com,REJECT
DOMAIN,device-security-url.jd.com,REJECT
DOMAIN,policy.jd.com,REJECT
# 注: jddebug.com 不做 REJECT —— 京东 App 自身会探测其随机子域(反劫持检测)；
# 脚本已不再使用该域名做观测日志(低耗电优化，移除每请求必超时 DNS 查询)
# --- 京东: 广告 ---
DOMAIN,im-x.jd.com,REJECT
# 注: imgcps.jd.com 已移除(2026-11-05)——实测流量走 imgcps1/2 子域,精确匹配从未命中(死规则),
# 且 imgcps 为 CPS 导购图片服务,疑似承载优惠券卡片图,保留有误杀领券页风险
# --- 京东: 推送长连接, 断配置/营销下发通道 (实验性补充, 可按需删除) ---
# JDBPushServiceModule 长连接承载 dispatchContent 路由分发(推送消息携带 routerUrl
# 可分发至任意模块,含广告数据),为开屏配置"不经 HTTP"的疑似载体;真通知走 APNs
# 兜底不受影响;SDK 有重试上限+enableTCPToHTTP 回退,无重试风暴风险;
# 若 Loon 日志出现 jpushsc 高频 reject 连发再撤;素材断供为主保险
DOMAIN,jpushsc.m.jd.com,REJECT
DOMAIN,jpushjd.m.jd.com,REJECT
DOMAIN,cloudpush.jd.com,REJECT
# --- 闲鱼: 阿里妈妈 Tanx 广告交易 (click.tanx.com / ifs.tanx.com / ef-dongfeng.tanx.com) ---
DOMAIN-SUFFIX,tanx.com,REJECT
# --- 腾讯广点通 ---
DOMAIN-SUFFIX,gdt.qq.com,REJECT
# --- 穿山甲 (CSJ) ---
DOMAIN-SUFFIX,ad.toutiao.com,REJECT
DOMAIN-SUFFIX,ad.oceanengine.com,REJECT
DOMAIN-SUFFIX,pangle.cn,REJECT
DOMAIN-SUFFIX,csjplatform.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,lf-ad-ies.bytecdn.cn,REJECT
DOMAIN,bridge.bytedance.com,REJECT
# --- 快手/百度联盟广告 ---
DOMAIN,e.kuaishou.com,REJECT
DOMAIN,mobads.baidu.com,REJECT
DOMAIN,mobads-logs.baidu.com,REJECT
# --- 闲鱼: Fanti (优酷/阿里文娱联盟) 广告SDK: 联盟开屏兜底/激励视频 (ssp.iytcdn.com) ---
DOMAIN-SUFFIX,iytcdn.com,REJECT
# --- 闲鱼: 优酷联盟视频SDK配置 (sealine.youku.com/sdkconfig_*.xml; 商品视频走
#     vod.300hu.com 不受影响。2026-10-29 抓包: 该域 DNS 解析为空仍反复重试) ---
DOMAIN,sealine.youku.com,REJECT
# --- 闲鱼: BeiZi 广告聚合SDK: s2s竞价与接口 (bid.ad-scope.com.cn / sdk.beizi.biz) ---
DOMAIN-SUFFIX,ad-scope.com.cn,REJECT
DOMAIN-SUFFIX,beizi.biz,REJECT
# --- 传祺: 埋点/统计上报域名 (基于 6.2.0 IPA 逆向) ---
# 神策埋点 (gets.gacmotor.com:8443/sa)
DOMAIN,gets.gacmotor.com,REJECT
# 字节 RangersAppLog 埋点
DOMAIN-SUFFIX,volceapplog.com,REJECT
# 友盟日志上报
DOMAIN,ulogs.umeng.com,REJECT
DOMAIN,ulogs.umengcloud.com,REJECT
DOMAIN,cnlogs.umeng.com,REJECT
DOMAIN,cnlogs.umengcloud.com,REJECT
DOMAIN,alogsus.umeng.com,REJECT
DOMAIN,alogus.umeng.com,REJECT
DOMAIN,log.umsns.com,REJECT
DOMAIN,c.umsns.com,REJECT
# 阿里 UT / EMAS / usertrack 埋点
DOMAIN,h-adashx.ut.taobao.com,REJECT
DOMAIN,adash.man.aliyuncs.com,REJECT
DOMAIN,service-usertrack.alibaba-inc.com,REJECT
# 传祺自有域名的 EMAS 上报 (app-emas.gacmotor.com:5443/u/...，2026-10-29 抓包)
DOMAIN,app-emas.gacmotor.com,REJECT
# 高德日志上报 (仅拦日志域，地图/定位功能域名不拦)
DOMAIN,logs.amap.com,REJECT
DOMAIN,dualstack-logs.amap.com,REJECT
# --- 传祺: 广告素材 CDN (华为 Ads) ---
DOMAIN,cdn.adscloud.huawei.com,REJECT
DOMAIN,cdn.adscloud.huawei.com.cn,REJECT

[Rewrite]
# ==================== 闲鱼 ====================
# --- 开屏广告 (FishSplashAd) ---
# 响应篡改方案(见 [Script] 闲鱼_开屏去广告): 删除 realTimeAd 节点让App主动跳过开屏,
# 不使用 reject(请求失败会触发联盟兜底/重试/缓存展示)。Fanti/BeiZi域名REJECT保留兜底。
# --- 直播首页广告 ---
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.live\.home\.ads\.material\.get\/ url reject
# --- 小游戏/互动激励广告 (看广告得奖励类，不需要可删除对应行) ---
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlecommerce\.game\.iaa\.ads\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.mini\.game\.ad\.url\.query\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.play\.ad\.(?:query|event\.(?:query|push))\/ url reject
# --- 鱼塘弹窗 ---
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.fishpool\.poplayerinfo\/ url reject
# --- 广告曝光/点击/结算上报 ---
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.idle\.ad\.(?:click|expose|failed\.batch\.(?:click|expose))\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.ali\.ad\.settle\.(?:brand\.log|cpc\.click|cpm\.click|tanx\.click|tianhe\.click)\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.tmall\.jiuxi\.activity\.ad\.upstream\.report\.(?:click|impression)\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.(?:life\.ad\.click\.get|o2o\.ad\.(?:action|exposure|gateway)\.get)\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.idle\.idleadv\.(?:app\.launch\.report|xyflowin\.upload|scene\.restore)\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlehome\.home\.pop\.interest\.upload\/ url reject
# --- 2026-11-06 信息流/搜索补强 (规则来源: kelee FleaMarket_remove_ads.lpx 2026-10-02,
#     仅并入去广告类; 新语法规则需 Loon 3.5.1(983)+, 与本插件 [Script] 段语法一致) ---
# 搜索结果: 删除 bizType=ad 的广告商品卡 (g-acs 网关; 闲鱼搜索"商品列表"内的广告)
response if ${url} ~= /^https?:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\//i then response.json.jq(".data.resultList |= map(if .data.item.main.exContent.dislikeFeedback.clickParam.args.bizType == \"ad\" then empty else . end)")
# 搜索结果: 删除结果前缀运营条
response if ${url} ~= /^https?:\/\/g-acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\//i then response.json.delete("data.resultPrefixBar")
# 搜索填充词
request if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlemtopsearch\.search\.shade\//i then reject_dict(200)
# 搜索发现页: 过滤 MarketHotSpot 运营热点
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlemtopsearch\.search\.discover\//i then response.json.jq(".data.resultList |= map(select(.type != \"MarketHotSpot\"))")
# 搜索框热词填充
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlemtopsearch\.item\.search\.activate\//i then response.json.jq(".data.cardList |= map(if has(\"cardData\") and (.cardData | has(\"hotwords\")) then .cardData |= del(.hotwords) else . end)")
# 详情页推荐列表 (与脚本内 detail_recommend_ad_card 卡片过滤互补)
request if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.item\.recommend\.list\//i then reject_dict(200)
# 关注页信息流: 只留正常卡片 (cardType 2001)
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.fun\.follow\.feed\.list\//i then response.json.jq(".data.sections|=map(select(.cardType==2001))")
# 社区信息流: 只留商品卡/内容卡
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlehome\.home\.community\//i then response.json.jq(".data.feedsList |= map(select(.template.name == \"idlefish_home_new_commodity_card\" or .template.name == \"idlefish_home_new_content_card\"))")
# 新品页: 过滤 banner/mamaAD 卡片
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlehome\.home\.newitem\.page\//i then response.json.jq(".data.sections |= map(select(.data.clickParam.args.cardType as $ct | $ct != \"banner\" and $ct != \"mamaAD\"))")
# 同城首页信息流: 过滤 cardEnum=ads 的广告卡片
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.local\.home\//i then response.json.jq(".data.sections |= map(select((.template.cardEnum != \"ads\") and (.cardType == \"common\")))")
# 魔法首页: 删顶部运营列表
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlehome\.magic\.home\.page\.list\//i then response.json.delete("data.topList")
# 广告策略配置/推荐流杂项
request if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.user\.strategy\.list\//i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.playboy\.recommend\//i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.item\.buy\.feeds\//i then reject_dict(200)
request if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.local\.near\.by\.corner\.info\//i then reject_dict(200)
# ==================== 京东 ====================
# --- 京东: 开屏广告素材断供 (2026-11-04 实锤; 2026-11-06 分片轮转修复) ---
# 开屏配置经推送通道下发(不经 HTTP,素材 URL 三次抓包全流量零命中),前台启动本地决策展示;
# 素材是唯一网络触点: 全屏开屏图 s1125x2436_jfs (Image_JDAppHome 预取) + material-video
# 视频开屏(主页面 avplayer 实时播放),断素材即断展示
# 16.1.81 IPA 实锤素材 URL 可落在任意 360buyimg 分片(App 自带正则
# (img([1-2]\d{0,1}|30)|m).360buyimg.com/.../s%dx%d_jfs/),故规则覆盖全分片;
# Rewrite 仅对 MITM 解密的 HTTPS 生效,[MITM] 已含 *.360buyimg.com
# 注意: App 内更新(覆盖安装)不清沙盒缓存, 需卸载重装才能清掉磁盘存量素材
^https?:\/\/[a-z0-9]+\.360buyimg\.com\/mobilecms\/s1\d{3}x2\d{3}_jfs\/ url reject
^https?:\/\/[a-z0-9]+\.?360buyimg\.com\/material-video\/ url reject
# --- 京东: 推荐流接口直接返回空 JSON ---
^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=uniformRecommend\d* url reject-dict
# --- storage.jd.com 上的推荐资源返回空 JSON ---
^https:\/\/storage\.jd\.com\/mpaas2-public\/product\/[^\/]+\/recommend_jdur url reject-dict
# --- 纯广告接口 (GET/OPTIONS 场景，URL 带 functionId) ---
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=queryPagePopWindow - reject
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=babelGetGuideTips - reject
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=secondFloor - reject
# ==================== 传祺 ====================
# 网关前缀: 生产 API 经网关路由路径带模块前缀(next.gacmotor.com/app/app-api/...、
# /mall/content-app/...)，与 IPA 裸路径不同，规则用 (?:[a-z0-9\-]+\/)* 通配兼容
# --- 开屏广告: 数据源(positionCode=1)与登录页开屏视频走响应篡改脚本(见 [Script] 段,
#     返回"成功但无广告"避免 reject 触发缓存兜底),此处不再 reject-dict ---
# --- 开屏广告弹窗开关 ---
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*app-api\/baseinfo\/advertise\/isalert url reject-dict
# --- 运营弹窗: 活动/车控任务/运动/车控端弹窗文本 ---
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*app-api\/car\/activity\/v2\/popup url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*car-api\/leopard\/school\/home\/taskPopup url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*car-api\/vcontrol\/sport\/avpopup url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*gacmotor-vehicle-app\/v1\/popup\/text\/selectPopupText url reject-dict
# --- Banner: 社区/商圈/商城/车控/充电服务 ---
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*community-api\/community\/api\/bannerlist url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*community-api\/community\/api\/post\/getcircleinfobanner url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*circle-api\/activity\/activityBanner\/list url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*mall-api\/commodity\/bannerList url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*mall-api\/mall\/home\/querySubCategoryBannerList url reject-dict
^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*gacmotor-vehicle-app\/v1\/banner\/selectList url reject-dict
# 充电服务 Banner (路径较通用，限定广汽域名避免误伤其他 App)
^https?:\/\/[a-z0-9\.\-]*gac(?:motor|ne|e)[a-z0-9\.\-]*\.com(?:\.cn)?\/(?:[a-z0-9\-]+\/)*api\/bannerlist url reject-dict
^https?:\/\/[a-z0-9\.\-]*gac(?:motor|ne|e)[a-z0-9\.\-]*\.com(?:\.cn)?\/(?:[a-z0-9\-]+\/)*v1\/banner\/selectList url reject-dict

[Script]
# ==================== 闲鱼: 开屏 realTimeAd 删除 + 信息流/详情页广告卡片过滤 ====================
# 开屏: 删除响应中的 realTimeAd 节点(2026-10-30 跨零点抓包实锤的开屏下发通道) + 通用归零兜底
# 注: 使用 Loon 3.5.1(983)+ 新语法(实测旧语法 http-response 在部分环境不触发,与京东脚本同因)
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlecommerce\.splash\.(?:ads|async\.ads|config)\//i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/XianyuSplashFix.js") with tag="闲鱼_开屏去广告", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlehome\.home(?:\.nextfresh)?\//i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/XianyuAdBlock.js") with tag="闲鱼_首页信息流去广告", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.home\.nextnearby\//i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/XianyuAdBlock.js") with tag="闲鱼_同城信息流去广告", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.(?:item\.detail|detail\.preget|awesome\.detail(?:\.unit)?)\//i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/XianyuAdBlock.js") with tag="闲鱼_详情页去广告", timeout=20, requires_body=true
# ==================== 京东 ====================
# 请求侧: 读取 POST body 中的 functionId(京东新网络栈将 fid 序列化进 body，URL 匹配对其无效)，
# 纯广告接口本地返回空 JSON，命中拦截时记录 [JD-FID] 日志(低耗电：不再全量流水/无观测 DNS 查询)
# 覆盖全部 API 网关域名变体(UnitRouter 机制): api/api-q/squnit-api/quic-api.m.jd.com, api-ai/squnit-api-ai.jd.com
# URL 正则含根路径 / 直传通道(2026-10-30 抓包发现)；注: 新语法(旧语法 http-request 部分环境不触发)
request if ${url} ~= /^https?:\/\/((api|api-q|squnit-api|quic-api)\.m\.jd\.com|(squnit-api-)?api-ai\.jd\.com)\/(?:client\.action|api)?(?:$|[\/?#])/i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/jd_ad_request.js") with tag="京东_广告请求拦截", timeout=20, requires_body=true
# 响应侧: aoconch 原版逻辑(fid 从 URL/body/嵌套 JSON 提取 + 楼层 mId/标题递归清理 + uniformRecommend 空包)
# + 本仓库增强: startADImage 清理(16.1.80 IPA)、双 $done 修复、[JD-FID] 命中日志、
# 开屏字段 fid 无关递归清理(加密 body/根路径通道兜底)、低耗电优化(无特征响应预检跳过/观测 DNS 查询移除)
response if ${url} ~= /^https?:\/\/((api|api-q|squnit-api|quic-api)\.m\.jd\.com|(squnit-api-)?api-ai\.jd\.com)\/(?:client\.action|api)?(?:$|[\/?#])/i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/JD_remove_ads.js") with tag="京东_广告响应清理", timeout=20, requires_body=true
# ==================== 传祺: 开屏广告响应篡改 ====================
# 开屏广告数据源(positionCode=1) + 登录页开屏视频: 返回"成功但无广告",
# 避免 reject 触发本地缓存/兜底展示 (参考闲鱼教训; Loon 日志搜 [GAC-AD])
response if ${url} ~= /^https?:\/\/[^\/]+\/(?:[a-z0-9\-]+\/)*app-api\/(?:baseinfo\/advertise\/getAdvertiseByPositionCode|login\/getLoginVideoAndCover)/i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/TrumpchiSplashFix.js") with tag="传祺_开屏响应篡改", timeout=20, requires_body=true

[MITM]
# 低耗电: 京东侧仅保留有 Rewrite/Script 规则实际命中的域名(mars/policy 已 REJECT，无需解密)，
# *.360buyimg.com 为开屏素材断供 Rewrite 所需(素材可落在任意分片,16.1.81 IPA 实锤;
# 代价是图片 CDN 解密,仅 TLS 握手开销/连接复用)；闲鱼侧已覆盖 goofish.com 新网关
# (2026-10-29 抓包确认 mtop 网关迁移)+旧 taobao.com 网关；传祺通配保持不变(收窄会漏广告)
hostname = acs.m.goofish.com, g-acs.m.goofish.com, acs.m.taobao.com, guide-acs.m.taobao.com, h5api.m.taobao.com, unszacs.m.taobao.com, unzbyunacs.m.taobao.com, api.m.jd.com, squnit-api.m.jd.com, quic-api.m.jd.com, api-q.m.jd.com, api-ai.jd.com, squnit-api-ai.jd.com, storage.jd.com, *.360buyimg.com, *.gacmotor.com, *.gacne.com.cn, *.gace.com.cn
