#!name = 闲鱼去广告
#!desc = 去除闲鱼开屏广告（2026-10-30 抓包实锤 realTimeAd 下发通道，删除该节点使 App 主动跳过）、首页/同城信息流广告、详情页推荐广告、直播/小游戏广告、鱼塘弹窗，并拦截广告曝光点击上报。基于闲鱼 7.28.80 (com.taobao.fleamarket) IPA 逆向 + 跨零点抓包分析；脚本已迁移 Loon 新语法并内置远程地址，安装即用。
#!author = y0unge
#!homepage = https://github.com/y0unge/ad-block-collection
#!category = 去广告
#!date = 2026-10-30

# ================================================================
# 闲鱼 (com.taobao.fleamarket) 去广告 Loon 插件
# 适配版本: 7.28.80 (脱壳 IPA 逆向)
# 网关迁移: 2026-10-29 抓包确认 mtop 已整体走 goofish.com 域名
#           (acs.m.goofish.com / g-acs.m.goofish.com)，脚本 URL 正则匹配任意
#           host 故无需改动，[MITM] 已加入新网关域名
#
# 逆向依据:
#   开屏广告   FishSplashAdManager 经 mtop.taobao.idlecommerce.splash.{ads,async.ads,config}
#              拉取；2026-10-30 跨零点抓包实锤实际下发通道为响应 data.realTimeAd.
#              mamaAd.imageMaterial(品牌广告,showNow:"true" 服务端实时决策,响应无
#              频控字段)，脚本删除 realTimeAd 节点(与服务器"当日无广告"响应形状
#              一致,App 主动跳过,不触发联盟兜底)
#   信息流广告 DinamicXPreset_homepage 模板: fish_home_advertise_card_d3/d4、
#              fish_local_advertise_card_d4、idlefish_local_feed2_marketing、
#              fish_home_feeds_pager_banner
#   详情页广告 DinamicXPreset_detail_recommend 模板: detail_recommend_ad_card
#   直播广告   mtop.taobao.idle.live.home.ads.material.get
#   小游戏广告 mtop.taobao.idlecommerce.game.iaa.ads / idle.mini.game.ad.url.query /
#              idle.play.ad.{query,event.query,event.push}
#   鱼塘弹窗   mtop.taobao.idle.fishpool.poplayerinfo
#   广告上报   mtop.idle.ad.{click,expose,...}、mtop.ali.ad.settle.*、tanx.com
#
# 使用说明:
#   1. Loon 安装并信任 CA 证书，开启 MITM 总开关
#   2. 安装本插件即可，脚本经远程地址自动加载
#   3. 观测: Loon 日志搜索 [XY-Splash](开屏)/[XY-Feed](信息流)
# ================================================================

[Rewrite]
# --- 开屏广告 (FishSplashAd) ---
# 响应篡改方案(见 [Script] 闲鱼_开屏去广告): 删除 realTimeAd 节点让App主动跳过开屏,
# 不使用 reject(请求失败会触发联盟兜底/重试/缓存展示)。Fanti/BeiZi域名REJECT保留兜底。

# --- 直播首页广告 ---
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.live\.home\.ads\.material\.get\/ url reject

# --- 小游戏/互动激励广告 (看广告得奖励类，不需要可删除对应行) ---
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlecommerce\.game\.iaa\.ads\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.mini\.game\.ad\.url\.query\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.play\.ad\.(?:query|event\.(?:query|push))\/ url reject

# --- 鱼塘弹窗 ---
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.fishpool\.poplayerinfo\/ url reject

# --- 广告曝光/点击/结算上报 ---
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.idle\.ad\.(?:click|expose|failed\.batch\.(?:click|expose))\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.ali\.ad\.settle\.(?:brand\.log|cpc\.click|cpm\.click|tanx\.click|tianhe\.click)\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.tmall\.jiuxi\.activity\.ad\.upstream\.report\.(?:click|impression)\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.(?:life\.ad\.click\.get|o2o\.ad\.(?:action|exposure|gateway)\.get)\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.idle\.idleadv\.(?:app\.launch\.report|xyflowin\.upload|scene\.restore)\/ url reject
^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlehome\.home\.pop\.interest\.upload\/ url reject

[Script]
# 开屏广告: 删除响应中的 realTimeAd 节点(2026-10-30 跨零点抓包实锤的开屏下发通道)
# + 频控/开关/素材字段通用归零兜底。观测: Loon 日志搜 [XY-Splash]
# 注: 使用 Loon 3.5.1(983)+ 新语法(实测旧语法 http-response 在部分环境不触发,与京东脚本同因)
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlecommerce\.splash\.(?:ads|async\.ads|config)\//i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/XianyuSplashFix.js") with tag="闲鱼_开屏去广告", timeout=20, requires_body=true
# 信息流/详情页广告卡片过滤
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idlehome\.home(?:\.nextfresh)?\//i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/XianyuAdBlock.js") with tag="闲鱼_首页信息流去广告", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.home\.nextnearby\//i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/XianyuAdBlock.js") with tag="闲鱼_同城信息流去广告", timeout=20, requires_body=true
response if ${url} ~= /^https?:\/\/[^\/]+\/[a-z0-9\/]*mtop\.taobao\.idle\.(?:item\.detail|detail\.preget|awesome\.detail(?:\.unit)?)\//i then script("https://raw.githubusercontent.com/y0unge/ad-block-collection/main/XianyuAdBlock.js") with tag="闲鱼_详情页去广告", timeout=20, requires_body=true

[Rule]
# 阿里妈妈 Tanx 广告交易 (click.tanx.com / ifs.tanx.com / ef-dongfeng.tanx.com)
DOMAIN-SUFFIX,tanx.com,REJECT
# 腾讯广点通
DOMAIN-SUFFIX,gdt.qq.com,REJECT
# 穿山甲 (CSJ)
DOMAIN-SUFFIX,ad.toutiao.com,REJECT
DOMAIN-SUFFIX,ad.oceanengine.com,REJECT
DOMAIN-SUFFIX,pangle.cn,REJECT
DOMAIN-SUFFIX,csjplatform.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,lf-ad-ies.bytecdn.cn,REJECT
DOMAIN,bridge.bytedance.com,REJECT
# 快手/百度联盟广告
DOMAIN,e.kuaishou.com,REJECT
DOMAIN,mobads.baidu.com,REJECT
DOMAIN,mobads-logs.baidu.com,REJECT
# Fanti (优酷/阿里文娱联盟) 广告SDK: 联盟开屏兜底/激励视频/广告配置 (ssp.iytcdn.com)
DOMAIN-SUFFIX,iytcdn.com,REJECT
# 优酷联盟视频SDK配置 (sealine.youku.com/sdkconfig_*.xml; 商品视频走 vod.300hu.com
# 不受影响。2026-10-29 抓包: 该域 DNS 解析为空仍反复重试)
DOMAIN,sealine.youku.com,REJECT
# BeiZi 广告聚合SDK: s2s竞价与接口 (bid.ad-scope.com.cn / sdk.beizi.biz)
DOMAIN-SUFFIX,ad-scope.com.cn,REJECT
DOMAIN-SUFFIX,beizi.biz,REJECT

[MITM]
# 2026-10-29 抓包确认: 闲鱼 mtop 网关已迁移至 goofish.com 域名
# (92/92 条业务请求走 acs.m.goofish.com / g-acs.m.goofish.com，含
#  splash.async.ads 开屏接口)，旧 *.m.taobao.com 网关保留兼容
hostname = acs.m.goofish.com, g-acs.m.goofish.com, acs.m.taobao.com, guide-acs.m.taobao.com, h5api.m.taobao.com, unszacs.m.taobao.com, unzbyunacs.m.taobao.com
